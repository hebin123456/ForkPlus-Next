<DataTemplate DataType="ui:RemoteBranchSidebarItem">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="{DynamicResource BranchIcon}" Height="16" Width="16" x:Name="RemoteBranchImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <ToolTip.Tip>
          <Binding Path="Tooltip" />
        </ToolTip.Tip>
      </TextBlock>
      <Button Grid.Column="2" x:Name="PinButton" Theme="{DynamicResource SidebarPinButton}" IsVisible="{Binding IsMouseOver}">
        <ToolTip.Tip>
          <Binding Path="PinTooltip" />
        </ToolTip.Tip>
        <Image Source="{DynamicResource PinOnIcon}" x:Name="PinButtonImage" />
      </Button>
      <Button Grid.Column="3" x:Name="FilterButton" Theme="{DynamicResource SidebarFilterButton}" IsVisible="{Binding !FilterState}">
        <ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </ToolTip.Tip>
        <Image Source="{DynamicResource BranchFilterOnIcon}" x:Name="FilterButtonImage" />
      </Button>
      <Button Grid.Column="4" x:Name="HideButton" Theme="{DynamicResource SidebarHideButton}" IsVisible="{Binding !FilterState}">
        <ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </ToolTip.Tip>
        <Image Source="{DynamicResource HideBranchOnIcon}" x:Name="HideButtonImage" />
      </Button>
    </Grid>
    
  
