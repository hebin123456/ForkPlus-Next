<DataTemplate DataType="ui:LocalBranchSidebarItem">
    <Grid HorizontalAlignment="Stretch">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Height="16" Width="16" x:Name="BranchImage">
        <Image.Source>
          <Binding Path="UpstreamStatus"><Binding.Converter><ui:UpstreamStatusToImageConverter /></Binding.Converter></Binding>
        </Image.Source>
      </Image>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" FontWeight="Normal" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <ToolTip.Tip>
          <Binding Path="Tooltip" />
        </ToolTip.Tip>
      </TextBlock>
      <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,2,0">
        <TextBlock.Text>
          <Binding Path="UpstreamStatusString" />
        </TextBlock.Text>
      </TextBlock>
      <Button Grid.Column="3" x:Name="PinButton" Theme="{DynamicResource SidebarPinButton}" IsVisible="{Binding IsMouseOver}">
        <ToolTip.Tip>
          <Binding Path="PinTooltip" />
        </ToolTip.Tip>
        <Image Source="{DynamicResource PinOnIcon}" x:Name="PinButtonImage" />
      </Button>
      <Button Grid.Column="4" x:Name="FilterButton" Theme="{DynamicResource SidebarFilterButton}" IsVisible="{Binding !FilterState}">
        <ToolTip.Tip>
          <Binding Path="FilterTooltip" />
        </ToolTip.Tip>
        <Image Source="{DynamicResource BranchFilterOnIcon}" x:Name="FilterButtonImage" />
      </Button>
      <Button Grid.Column="5" x:Name="HideButton" Theme="{DynamicResource SidebarHideButton}" IsVisible="{Binding !FilterState}">
        <ToolTip.Tip>
          <Binding Path="HideTooltip" />
        </ToolTip.Tip>
        <Image Source="{DynamicResource HideBranchOnIcon}" x:Name="HideButtonImage" />
      </Button>
    </Grid>
    
  
    <!--
      TODO(wpf2avalonia): DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsSelected"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsKeyboardFocusWithin"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="BranchImage" Property="Source">
                <Setter.Value>
                  <Binding Path="UpstreamStatus"><Binding.Converter><ui:UpstreamStatusToImageConverter xmlns:ui="clr-namespace:ForkPlus.UI" /></Binding.Converter></Binding>
                </Setter.Value>
              </Setter>
            </MultiDataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="LocalBranch.IsActive" />
              </DataTrigger.Binding>
              <Setter TargetName="BranchImage" Value="{DynamicResource ActiveBranchIcon}" Property="Source" />
              <Setter TargetName="TitleTextBlock" Property="FontWeight" Value="Bold" />
            </DataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="LocalBranch.IsActive" />
                  </Condition.Binding>
                </Condition>
