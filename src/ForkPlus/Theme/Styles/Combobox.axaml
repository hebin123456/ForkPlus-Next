<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="ComboboxShadowBorderStyle" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="8,0,8,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="10" Color="{DynamicResource DropShadowColor}" Opacity="0.2" OffsetY="1" />
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    
    
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Margin" Value="1,1" />
    <Setter Property="Height" Value="22" />
    <Setter Property="HorizontalContentAlignment">
      <Setter.Value>
        <Binding Path="HorizontalContentAlignment"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ItemsControl}" /></Binding.RelativeSource></Binding>
      </Setter.Value>
    </Setter>
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="0" Height="{TemplateBinding Height}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="Bd">
            <DockPanel>
              <Border DockPanel.Dock="Left" Margin="1,3,1,3" Width="3" CornerRadius="2" BorderThickness="0" Background="{DynamicResource SystemAccentBrush}" VerticalAlignment="Stretch" x:Name="SelectionIndicator" IsVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </DockPanel>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:disabled /template/ Border#Bd">
<!-- TODO 迁移：WPF Foreground Setter 已删（Avalonia Border 无 Foreground 属性） -->
    </Style>
    <Style Selector="^:selected /template/ Border#SelectionIndicator">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[IsSelected=False]:pointerover[IsKeyboardFocused=False] /template/ Border#Bd">
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewHover.Background}" Property="Background" />
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewHover.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:selected:focus /template/ Border#Bd">
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewSelected.Background}" Property="Background" />
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewSelected.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:selected:pointerover /template/ Border#Bd">
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewSelectedHover.Background}" Property="Background" />
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewSelectedHover.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:selected[IsKeyboardFocused=False] /template/ Border#Bd">
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewSelectedNoFocus.Background}" Property="Background" />
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewSelectedNoFocus.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^[IsSelected=False]:focus /template/ Border#Bd">
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewFocus.Background}" Property="Background" />
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewFocus.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^[IsSelected=False]:pointerover:focus /template/ Border#Bd">
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewHoverFocus.Background}" Property="Background" />
        <Setter Value="{DynamicResource ComboBoxItem.ItemsviewHoverFocus.Border}" Property="BorderBrush" />
    </Style></ControlTheme>
  <ControlTheme x:Key="SeparatorComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Separator HorizontalAlignment="Stretch" Margin="0" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="SmallComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
    <Setter Property="Height" Value="18" />
  </ControlTheme>
  <ControlTheme x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
    
    <Setter Property="KeyboardNavigation.IsTabStop" Value="false" />
    <Setter Property="Focusable" Value="false" />
<!-- TODO 迁移：WPF Setter Property=ClickMode 已删（Avalonia 无该属性/值） -->
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="templateRoot">
            <Border BorderBrush="#00FFFFFF" Margin="0" BorderThickness="1,0,0,0" HorizontalAlignment="Right" Width="20" CornerRadius="0,3,3,0" x:Name="splitBorder">
              <Path Data="M9.041,1.657L5,5.698 0.959,1.657 1.638,0.98 5,4.342 8.362,0.98 9.041,1.657z" Fill="{DynamicResource ComboBox.Static.Glyph}" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" x:Name="arrow" />
            </Border>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^[IsEditable=true] /template/ Border#splitBorder">
        <Setter Value="{DynamicResource ComboBox.Static.Editable.Button.Background}" Property="Background" />
        <Setter Value="{DynamicResource ComboBox.Static.Editable.Button.Border}" Property="BorderBrush" />
    </Style>
    <Style Selector="^:pressed /template/ Path#arrow">
        <Setter Value="{DynamicResource ComboBox.Pressed.Glyph}" Property="Fill" />
    </Style>
    <Style Selector="^:disabled /template/ Border#templateRoot">
        <Setter Property="Opacity" Value="0.56" />
    </Style>
    <!--
      TODO(wpf2avalonia): 多条件 MultiDataTrigger（控件属性）需人工改写为段链选择器（^:a[Prop=v] /template/ …）。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
                    <MultiDataTrigger.Conditions>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsEditable"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ComboBox}" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsMouseOver"><Binding.RelativeSource><RelativeSource Mode="Self" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsPressed"><Binding.RelativeSource><RelativeSource Mode="Self" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsEnabled"><Binding.RelativeSource><RelativeSource Mode="Self" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Static.Editable.Background}" Property="Background" />
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Static.Editable.Border}" Property="BorderBrush" />
                  </MultiDataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): 多条件 MultiDataTrigger（控件属性）需人工改写为段链选择器（^:a[Prop=v] /template/ …）。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
                    <MultiDataTrigger.Conditions>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsPressed"><Binding.RelativeSource><RelativeSource Mode="Self" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsEditable"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ComboBox}" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Background}" Property="Background" />
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Border}" Property="BorderBrush" />
                  </MultiDataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): 多条件 MultiDataTrigger（控件属性）需人工改写为段链选择器（^:a[Prop=v] /template/ …）。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
                    <MultiDataTrigger.Conditions>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsPressed"><Binding.RelativeSource><RelativeSource Mode="Self" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsEditable"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ComboBox}" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Editable.Background}" Property="Background" />
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Editable.Border}" Property="BorderBrush" />
                    <Setter TargetName="splitBorder" Value="{DynamicResource ComboBox.Pressed.Editable.Button.Background}" Property="Background" />
                    <Setter TargetName="splitBorder" Value="{DynamicResource ComboBox.Pressed.Editable.Button.Border}" Property="BorderBrush" />
                  </MultiDataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): 多条件 MultiDataTrigger（控件属性）需人工改写为段链选择器（^:a[Prop=v] /template/ …）。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
                    <MultiDataTrigger.Conditions>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsChecked"><Binding.RelativeSource><RelativeSource Mode="Self" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsEditable"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ComboBox}" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Background}" Property="Background" />
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Border}" Property="BorderBrush" />
                  </MultiDataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): 多条件 MultiDataTrigger（控件属性）需人工改写为段链选择器（^:a[Prop=v] /template/ …）。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
                    <MultiDataTrigger.Conditions>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsChecked"><Binding.RelativeSource><RelativeSource Mode="Self" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                      <Condition Value="true">
                        <Condition.Binding>
                          <Binding Path="IsEditable"><Binding.RelativeSource><RelativeSource AncestorType="{x:Type ComboBox}" /></Binding.RelativeSource></Binding>
                        </Condition.Binding>
                      </Condition>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Editable.Background}" Property="Background" />
                    <Setter TargetName="templateRoot" Value="{DynamicResource ComboBox.Pressed.Editable.Border}" Property="BorderBrush" />
                    <Setter TargetName="splitBorder" Value="{DynamicResource ComboBox.Pressed.Editable.Button.Background}" Property="Background" />
                    <Setter TargetName="splitBorder" Value="{DynamicResource ComboBox.Pressed.Editable.Button.Border}" Property="BorderBrush" />
                  </MultiDataTrigger>
    --></ControlTheme>
  <ControlTemplate x:Key="ComboBoxTemplate" TargetType="ComboBox">
    <Grid x:Name="templateRoot">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition MinWidth="20" Width="0" />
      </Grid.ColumnDefinitions>
      <Popup Grid.ColumnSpan="2" Placement="Bottom" HorizontalOffset="-8" VerticalOffset="1" Margin="1" x:Name="PART_Popup">
        <Popup.IsOpen>
          <Binding Path="IsDropDownOpen"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
        </Popup.IsOpen>
        <Border Theme="{DynamicResource ComboboxShadowBorderStyle}">
          <Border MaxHeight="{TemplateBinding MaxDropDownHeight}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="1,1,1,1" CornerRadius="6" x:Name="dropDownBorder">
            <Border.Width>
              <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
            </Border.Width>
            <ScrollViewer Background="#00FFFFFF" Margin="2" x:Name="DropDownScrollViewer">
              <Grid Background="#00FFFFFF" x:Name="grid">
                <Canvas HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0" Background="#00FFFFFF" x:Name="canvas">
                  <Rectangle x:Name="opaqueRect">
                    <Rectangle.Fill>
                      <Binding ElementName="dropDownBorder" Path="Background" />
                    </Rectangle.Fill>
                    <Rectangle.Height>
                      <Binding ElementName="dropDownBorder" Path="ActualHeight" />
                    </Rectangle.Height>
                    <Rectangle.Width>
                      <Binding ElementName="dropDownBorder" Path="ActualWidth" />
                    </Rectangle.Width>
                  </Rectangle>
                </Canvas>
                <ItemsPresenter x:Name="ItemsPresenter" />
              </Grid>
            </ScrollViewer>
          </Border>
        </Border>
      </Popup>
      <ToggleButton BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.ColumnSpan="2" x:Name="toggleButton" Theme="{StaticResource ComboBoxToggleButton}">
        <ToggleButton.IsChecked>
          <Binding Path="IsDropDownOpen"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
        </ToggleButton.IsChecked>
      </ToggleButton>
      <ContentPresenter ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="false" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="contentPresenter" />
    </Grid>
    <!--
      TODO(wpf2avalonia): ControlTemplate.Triggers（裸模板资源）：Avalonia 无等价，条件样式须移至 ControlTheme 嵌套样式。
      原始片段：
      <ControlTemplate.Triggers xmlns="https://github.com/avaloniaui">
            <Trigger Property="ItemsControl.HasItems" Value="false">
              <Setter TargetName="dropDownBorder" Property="FrameworkElement.Height" Value="95" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ItemsControl.IsGrouping" Value="true" />
                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
              </MultiTrigger.Conditions>
              <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
            </MultiTrigger>
            <Trigger SourceName="DropDownScrollViewer" Property="ScrollViewer.CanContentScroll" Value="false">
              <Setter TargetName="opaqueRect" Property="Canvas.Top">
                <Setter.Value>
                  <Binding ElementName="DropDownScrollViewer" Path="VerticalOffset" Mode="OneWay" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="opaqueRect" Property="Canvas.Left">
                <Setter.Value>
                  <Binding ElementName="DropDownScrollViewer" Path="HorizontalOffset" Mode="OneWay" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
    -->
  </ControlTemplate>
  <ControlTheme x:Key="ComboBoxEditableTextBox" TargetType="TextBox">
    
<!-- TODO 迁移：WPF Setter Property=AllowDrop 已删（Avalonia 无该属性/值） -->
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ForegroundBrush}" />
    
<!-- TODO 迁移：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
<!-- TODO 迁移：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <TextPresenter x:Name="PART_TextPresenter" Text="{TemplateBinding Text}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
  <ControlTemplate x:Key="ComboBoxEditableTemplate" TargetType="ComboBox">
    <Grid x:Name="templateRoot">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition MinWidth="20" Width="0" />
      </Grid.ColumnDefinitions>
      <Popup Grid.ColumnSpan="2" Placement="Bottom" HorizontalOffset="-8" VerticalOffset="-8" x:Name="PART_Popup">
        <Popup.IsOpen>
          <Binding Path="IsDropDownOpen"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
        </Popup.IsOpen>
        <Border Theme="{DynamicResource ComboboxShadowBorderStyle}">
          <Border MaxHeight="{TemplateBinding MaxDropDownHeight}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="1,1,1,1" CornerRadius="6" x:Name="dropDownBorder">
            <Border.Width>
              <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
            </Border.Width>
            <ScrollViewer Background="#00FFFFFF" Margin="2" x:Name="DropDownScrollViewer">
              <Grid Background="#00FFFFFF" x:Name="grid">
                <Canvas HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0" Background="#00FFFFFF" x:Name="canvas">
                  <Rectangle x:Name="opaqueRect">
                    <Rectangle.Fill>
                      <Binding ElementName="dropDownBorder" Path="Background" />
                    </Rectangle.Fill>
                    <Rectangle.Height>
                      <Binding ElementName="dropDownBorder" Path="ActualHeight" />
                    </Rectangle.Height>
                    <Rectangle.Width>
                      <Binding ElementName="dropDownBorder" Path="ActualWidth" />
                    </Rectangle.Width>
                  </Rectangle>
                </Canvas>
                <ItemsPresenter x:Name="ItemsPresenter" />
              </Grid>
            </ScrollViewer>
          </Border>
        </Border>
      </Popup>
      <ToggleButton BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.ColumnSpan="2" x:Name="toggleButton" Theme="{StaticResource ComboBoxToggleButton}">
        <ToggleButton.IsChecked>
          <Binding Path="IsDropDownOpen"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
        </ToggleButton.IsChecked>
      </ToggleButton>
      <Border Margin="0" CornerRadius="3,0,0,3" BorderThickness="1" Padding="4,2" Background="{DynamicResource TextBox.Static.Background}" BorderBrush="#00FFFFFF" x:Name="border">
        <TextBox HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" x:Name="PART_EditableTextBox" Theme="{StaticResource ComboBoxEditableTextBox}">
          <TextBox.IsReadOnly>
            <Binding Path="IsReadOnly"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
          </TextBox.IsReadOnly>
        </TextBox>
      </Border>
    </Grid>
    <!--
      TODO(wpf2avalonia): ControlTemplate.Triggers（裸模板资源）：Avalonia 无等价，条件样式须移至 ControlTheme 嵌套样式。
      原始片段：
      <ControlTemplate.Triggers xmlns="https://github.com/avaloniaui">
            <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="true">
              <Setter Value="{DynamicResource ForegroundBrush}" Property="TextElement.Foreground" />
              <Setter TargetName="border" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="ItemsControl.HasItems" Value="false">
              <Setter TargetName="dropDownBorder" Property="FrameworkElement.Height" Value="95" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ItemsControl.IsGrouping" Value="true" />
                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
              </MultiTrigger.Conditions>
              <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
            </MultiTrigger>
            <Trigger SourceName="DropDownScrollViewer" Property="ScrollViewer.CanContentScroll" Value="false">
              <Setter TargetName="opaqueRect" Property="Canvas.Top">
                <Setter.Value>
                  <Binding ElementName="DropDownScrollViewer" Path="VerticalOffset" Mode="OneWay" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="opaqueRect" Property="Canvas.Left">
                <Setter.Value>
                  <Binding ElementName="DropDownScrollViewer" Path="HorizontalOffset" Mode="OneWay" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
    -->
  </ControlTemplate>
  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    
    <Setter Property="Background" Value="{DynamicResource ComboBox.Static.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ComboBox.Static.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Padding" Value="6,3,0,3" />
    <Setter Property="Height" Value="24" />
<!-- TODO 迁移：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
<!-- TODO 迁移：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
<!-- TODO 迁移：WPF 专有属性 Setter 已删（Avalonia 无此属性） -->
    <Setter Property="Template" Value="{StaticResource ComboBoxTemplate}" />
    
  
    <Style Selector="^[IsEditable=true]">
        <Setter Property="KeyboardNavigation.IsTabStop" Value="false" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template" Value="{StaticResource ComboBoxEditableTemplate}" />
    </Style></ControlTheme>
  <ControlTheme x:Key="InteractiveRebaseToggleButton" TargetType="ToggleButton">
    
    <Setter Property="Margin" Value="0,2,0,2" />
    <Setter Property="KeyboardNavigation.IsTabStop" Value="false" />
    <Setter Property="Focusable" Value="false" />
<!-- TODO 迁移：WPF Setter Property=ClickMode 已删（Avalonia 无该属性/值） -->
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border BorderBrush="{DynamicResource ComboBox.Static.Border}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" x:Name="templateRoot">
            <Border HorizontalAlignment="Right" Margin="0" x:Name="splitBorder">
              <Path Data="M9.041,1.657L5,5.698 0.959,1.657 1.638,0.98 5,4.342 8.362,0.98 9.041,1.657z" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" Margin="0,0,6,0" VerticalAlignment="Center" x:Name="arrow" />
            </Border>
          </Border>
          
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  
    <Style Selector="^:pointerover /template/ Border#templateRoot">
        <Setter Value="{DynamicResource InteractiveRebase.ComboBoxButton.MouseOver}" Property="Background" />
    </Style></ControlTheme>
  <ControlTemplate x:Key="InteractiveRebaseComboBoxTemplate" TargetType="ComboBox">
    <Grid x:Name="templateRoot">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
      </Grid.ColumnDefinitions>
      <Popup Grid.ColumnSpan="2" Placement="Bottom" HorizontalOffset="-8" VerticalOffset="-8" Margin="1" TextElement.Foreground="{DynamicResource ForegroundBrush}" x:Name="PART_Popup">
        <Popup.IsOpen>
          <Binding Path="IsDropDownOpen"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
        </Popup.IsOpen>
        <Border Theme="{DynamicResource ComboboxShadowBorderStyle}">
          <Border BorderBrush="{DynamicResource ComboBox.Popup.BorderBrush}" BorderThickness="1,1,1,1" Background="{DynamicResource ComboBox.Popup.BackgroundBrush}" MaxHeight="{TemplateBinding MaxDropDownHeight}" CornerRadius="6" x:Name="dropDownBorder">
            <Border.Width>
              <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
            </Border.Width>
            <ScrollViewer Background="#00FFFFFF" Margin="2" x:Name="DropDownScrollViewer">
              <Grid x:Name="grid">
                <Canvas HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0" x:Name="canvas">
                  <Rectangle x:Name="opaqueRect">
                    <Rectangle.Fill>
                      <Binding ElementName="dropDownBorder" Path="Background" />
                    </Rectangle.Fill>
                    <Rectangle.Height>
                      <Binding ElementName="dropDownBorder" Path="ActualHeight" />
                    </Rectangle.Height>
                    <Rectangle.Width>
                      <Binding ElementName="dropDownBorder" Path="ActualWidth" />
                    </Rectangle.Width>
                  </Rectangle>
                </Canvas>
                <ItemsPresenter x:Name="ItemsPresenter" />
              </Grid>
            </ScrollViewer>
          </Border>
        </Border>
      </Popup>
      <ToggleButton BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" Grid.ColumnSpan="2" x:Name="toggleButton" Theme="{StaticResource InteractiveRebaseToggleButton}">
        <ToggleButton.IsChecked>
          <Binding Path="IsDropDownOpen"><Binding.RelativeSource><RelativeSource Mode="TemplatedParent" /></Binding.RelativeSource></Binding>
        </ToggleButton.IsChecked>
      </ToggleButton>
      <ContentPresenter ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="false" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" x:Name="contentPresenter" />
    </Grid>
    <!--
      TODO(wpf2avalonia): ControlTemplate.Triggers（裸模板资源）：Avalonia 无等价，条件样式须移至 ControlTheme 嵌套样式。
      原始片段：
      <ControlTemplate.Triggers xmlns="https://github.com/avaloniaui">
            <Trigger Property="ItemsControl.HasItems" Value="false">
              <Setter TargetName="dropDownBorder" Property="FrameworkElement.Height" Value="95" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ItemsControl.IsGrouping" Value="true" />
                <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false" />
              </MultiTrigger.Conditions>
              <Setter Property="ScrollViewer.CanContentScroll" Value="false" />
            </MultiTrigger>
            <Trigger SourceName="DropDownScrollViewer" Property="ScrollViewer.CanContentScroll" Value="false">
              <Setter TargetName="opaqueRect" Property="Canvas.Top">
                <Setter.Value>
                  <Binding ElementName="DropDownScrollViewer" Path="VerticalOffset" Mode="OneWay" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="opaqueRect" Property="Canvas.Left">
                <Setter.Value>
                  <Binding ElementName="DropDownScrollViewer" Path="HorizontalOffset" Mode="OneWay" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
    -->
  </ControlTemplate>
  <ControlTheme x:Key="InteractiveRebaseComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    
    <Setter Property="Padding" Value="4,2,4,1" />
    <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template" Value="{StaticResource InteractiveRebaseComboBoxTemplate}" />
<!-- TODO 迁移：WPF Style.Resources 块（Avalonia Style 无 Resources 属性）。原始片段：
    <Style.Resources>
      <ResourceDictionary>
        <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
          
        </ControlTheme>
      </ResourceDictionary>
    </Style.Resources>-->

  </ControlTheme>
</ResourceDictionary>