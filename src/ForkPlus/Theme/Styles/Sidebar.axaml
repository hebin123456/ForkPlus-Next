                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="PinButtonImage" Value="{DynamicResource PinOffSelectedIcon}" Property="Source" />
              <Setter TargetName="FilterButtonImage" Value="{DynamicResource BranchFilterOffSelectedIcon}" Property="Source" />
              <Setter TargetName="HideButtonImage" Value="{DynamicResource HideBranchOffSelectedIcon}" Property="Source" />
            </MultiDataTrigger>
    -->
    <!--
