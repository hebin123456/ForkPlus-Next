    </Grid>
    
  
    <!--
      TODO(wpf2avalonia): DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsSelected"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsKeyboardFocusWithin"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="WorktreeImage" Value="{DynamicResource WorktreeSelectedIcon}" Property="Source" />
            </MultiDataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="Worktree.IsActive" />
              </DataTrigger.Binding>
              <Setter TargetName="TitleTextBlock" Property="FontWeight" Value="Bold" />
            </DataTrigger>
    --></DataTemplate>
  <DataTemplate x:Key="MainWorktreeSidebarItemTemplate" DataType="ui:MainWorktreeSidebarItem">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Grid.Column="0" Source="{DynamicResource WorktreeIcon}" Height="16" Width="16" x:Name="WorktreeImage" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" x:Name="TitleTextBlock">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <ToolTip.Tip>
          <Binding Path="Tooltip" />
        </ToolTip.Tip>
      </TextBlock>
    </Grid>
    
  
    <!--
      TODO(wpf2avalonia): DataTemplate.Triggers 内非 DataTrigger 触发器需人工改写。
      原始片段：
      <MultiDataTrigger xmlns="https://github.com/avaloniaui">
              <MultiDataTrigger.Conditions>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsSelected"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
                <Condition Value="true">
                  <Condition.Binding>
                    <Binding Path="IsKeyboardFocusWithin"><Binding.RelativeSource><RelativeSource Mode="FindAncestor" AncestorType="{x:Type controls:TreeViewControlItem}" /></Binding.RelativeSource></Binding>
                  </Condition.Binding>
                </Condition>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="WorktreeImage" Value="{DynamicResource WorktreeSelectedIcon}" Property="Source" />
            </MultiDataTrigger>
    -->
    <!--
      TODO(wpf2avalonia): DataTrigger 的非 Visibility Setter（外观属性）无模板级等价物：建议在 VM 增加计算属性 + Classes 类选择器。
      原始片段：
      <DataTrigger Value="True" xmlns="https://github.com/avaloniaui">
              <DataTrigger.Binding>
                <Binding Path="Worktree.IsActive" />
              </DataTrigger.Binding>
              <Setter TargetName="TitleTextBlock" Property="FontWeight" Value="Bold" />
            </DataTrigger>
    --></DataTemplate>
</ResourceDictionary>