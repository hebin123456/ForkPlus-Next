  <x:String x:Key="GiteaOnIcon">avares://ForkPlus/Assets/GiteaOn.png</x:String>
  <x:String x:Key="GenericRemoteIcon">avares://ForkPlus/Assets/Remote.png</x:String>
  <x:String x:Key="GenericRemoteOnIcon">avares://ForkPlus/Assets/RemoteOn.png</x:String>
  <!-- 业务层 IconKeys 用带 "Remote." 前缀的键（Remote.Azure / Remote.Bitbucket / ...），
       与上面 XxxIcon 键不一致，导致 FindImage 找不到退化成 GenericRemoteIcon（全是 Remote.png）。
       这里追加同名别名指向同一份 png，让两套键都能解析到正确图标。-->
  <x:String x:Key="Remote.Azure">avares://ForkPlus/Assets/Azure.png</x:String>
  <x:String x:Key="Remote.Bitbucket">avares://ForkPlus/Assets/BitBucket.png</x:String>
  <x:String x:Key="Remote.Gitea">avares://ForkPlus/Assets/Gitea.png</x:String>
  <x:String x:Key="Remote.Github">avares://ForkPlus/Assets/Github.png</x:String>
  <x:String x:Key="Remote.Gitlab">avares://ForkPlus/Assets/Gitlab.png</x:String>
  <x:String x:Key="Remote.Generic">avares://ForkPlus/Assets/Remote.png</x:String>
</ResourceDictionary>
