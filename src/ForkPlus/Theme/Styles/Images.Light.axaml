  <x:String x:Key="GitHubOnIcon">avares://ForkPlus/Assets/GithubOn.png</x:String>
  <x:String x:Key="GitLabIcon">avares://ForkPlus/Assets/Gitlab.png</x:String>
  <x:String x:Key="GitLabOnIcon">avares://ForkPlus/Assets/GitlabOn.png</x:String>
