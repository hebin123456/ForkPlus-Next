<UserControl xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForkPlus.UI.UserControls.Preferences.CredentialsUserControl" xmlns="https://github.com/avaloniaui">
  <Grid Width="540">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Saved HTTP(S) credentials and prompt preferences. 'Remember password' fills credentials in automatically; 'Never ask again' hosts fail fast when credentials are missing — re-enable prompting here at any time." TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10" x:Name="DescriptionTextBlock" />
    <ScrollViewer Grid.Row="1" MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="CredentialsListPanel" />
    </ScrollViewer>
    <Button Grid.Row="2" Content="Ask Again for All Hosts" Click="AskAllAgainButton_Click" x:Name="AskAllAgainButton" HorizontalAlignment="Left" Margin="0,12,0,0" />
  </Grid>
</UserControl>
