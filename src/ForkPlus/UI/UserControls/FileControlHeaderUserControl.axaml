                        </Setter.Property>
                        <Setter.Value>
                          <DynamicResource ResourceKey="ShowHiddenSymbolsOnIcon" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType=ToggleButton}}" Value="False">
                      <Setter>
                        <Setter.Property>
                          <x:Static Member="Image.SourceProperty" />
                        </Setter.Property>
                        <Setter.Value>
                          <DynamicResource ResourceKey="ShowHiddenSymbolsIcon" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers> -->

                </Style>
              </Image.Style>
            </Image>
          </ToggleButton>
          <ToggleButton IsTabStop="False" Click="WordWrapToggleButton_Click" x:Name="WordWrapToggleButton">
            <ToggleButton.Theme>
              <DynamicResource ResourceKey="CodeEditorHeaderToggleButtonStyle" />
            </ToggleButton.Theme>
            <ToolTip.Tip>Word wrap</ToolTip.Tip>
            <Image>
              <Image.Style>
                <Style>
                  <Style.TargetType>
                    <x:Type Type="Image" />
                  </Style.TargetType>
                  <!-- TODO 迁移：WPF Style.Triggers 块注释化（Avalonia 无触发器，视觉状态需用样式选择器/伪类实现：:pointerover/:pressed/:disabled/:focus/:selected 等）。
                    原始片段：<Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType=ToggleButton}}" Value="True">
                      <Setter>
                        <Setter.Property>
                          <x:Static Member="Image.SourceProperty" />
                        </Setter.Property>
                        <Setter.Value>
                          <DynamicResource ResourceKey="WordWrapOnIcon" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType=ToggleButton}}" Value="False">
                      <Setter>
                        <Setter.Property>
                          <x:Static Member="Image.SourceProperty" />
                        </Setter.Property>
                        <Setter.Value>
                          <DynamicResource ResourceKey="WordWrapIcon" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers> -->

                </Style>
              </Image.Style>
            </Image>
          </ToggleButton>
          <Button IsTabStop="False" Click="DecreaseVisibleLines_Click" x:Name="DecreaseNumberOfVisibleLinesButton">
            <Button.Theme>
              <DynamicResource ResourceKey="CodeEditorHeaderButtonStyle" />
            </Button.Theme>
            <ToolTip.Tip>Decrease number of visible lines</ToolTip.Tip>
            <Image>
              <Image.Source>
                <DynamicResource ResourceKey="DecreaseVisibleLinesIcon" />
              </Image.Source>
            </Image>
          </Button>
          <Button IsTabStop="False" Click="IncreaseVisibleLines_Click" x:Name="IncreaseNumberOfVisibleLinesButton">
            <Button.Theme>
              <DynamicResource ResourceKey="CodeEditorHeaderButtonStyle" />
            </Button.Theme>
            <ToolTip.Tip>Increase number of visible lines</ToolTip.Tip>
            <Image>
              <Image.Source>
                <DynamicResource ResourceKey="IncreaseVisibleLinesIcon" />
              </Image.Source>
            </Image>
          </Button>
          <ToggleButton IsTabStop="False" Click="ShowEntireFileToggleButton_Click" x:Name="ShowEntireFileToggleButton">
            <ToggleButton.Theme>
              <DynamicResource ResourceKey="CodeEditorHeaderToggleButtonStyle" />
            </ToggleButton.Theme>
            <ToolTip.Tip>Show entire file</ToolTip.Tip>
            <Image>
              <Image.Style>
                <Style>
                  <Style.TargetType>
                    <x:Type Type="Image" />
                  </Style.TargetType>
                  <!-- TODO 迁移：WPF Style.Triggers 块注释化（Avalonia 无触发器，视觉状态需用样式选择器/伪类实现：:pointerover/:pressed/:disabled/:focus/:selected 等）。
                    原始片段：<Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType=ToggleButton}}" Value="True">
                      <Setter>
                        <Setter.Property>
                          <x:Static Member="Image.SourceProperty" />
                        </Setter.Property>
                        <Setter.Value>
                          <DynamicResource ResourceKey="ShowEntireFileOnIcon" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType=ToggleButton}}" Value="False">
                      <Setter>
                        <Setter.Property>
                          <x:Static Member="Image.SourceProperty" />
                        </Setter.Property>
                        <Setter.Value>
                          <DynamicResource ResourceKey="ShowEntireFileIcon" />
                        </Setter.Value>
                      </Setter>
                    </DataTrigger>
                  </Style.Triggers> -->

                </Style>
              </Image.Style>
            </Image>
          </ToggleButton>
          <ToggleButton IsTabStop="False" Click="DiffLayoutModeToggleButton_Click" x:Name="DiffLayoutModeToggleButton">
            <ToggleButton.Theme>
              <DynamicResource ResourceKey="CodeEditorHeaderToggleButtonStyle" />
            </ToggleButton.Theme>
            <Image>
              <Image.Style>
                <Style>
                  <Style.TargetType>
                    <x:Type Type="Image" />
                  </Style.TargetType>
                  <!-- TODO 迁移：WPF Style.Triggers 块注释化（Avalonia 无触发器，视觉状态需用样式选择器/伪类实现：:pointerover/:pressed/:disabled/:focus/:selected 等）。
