                      </Setter>
                    </DataTrigger>
                  </Style.Triggers> -->

                </Style>
              </Image.Style>
            </Image>
          </ToggleButton>
        </StackPanel.Children>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" x:Name="ImageModeButtonsContainer" IsVisible="False">
        <StackPanel.Children>
          <ToggleButton IsTabStop="False" Click="HighlightPixelsToggleButton_Click" x:Name="HighlightPixelsToggleButton">
            <ToggleButton.Theme>
              <DynamicResource ResourceKey="CodeEditorHeaderToggleButtonStyle" />
            </ToggleButton.Theme>
            <ToolTip.Tip>Highlight pixels</ToolTip.Tip>
            <Image>
              <Image.Style>
                <Style>
                  <Style.TargetType>
                    <x:Type Type="Image" />
